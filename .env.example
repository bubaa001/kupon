# ---------------------------------------------------------------------------
# Kupon environment configuration
# Copy this file to `.env` and set your Supabase database password before use.
# ---------------------------------------------------------------------------

# Supabase PostgreSQL. URL-encode special characters in your database password.
# Transaction pooler (port 6543) is for application queries; session pooler
# (port 5432) is for Prisma migrations.
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# Signing secret for session cookies and 120-second payment QR tokens.
# Generate with: openssl rand -base64 48
JWT_SECRET="kupon-dev-only-secret-change-me-to-a-64-char-random-string"

# Payments
PAYMENT_PROVIDER="mock"
PLATFORM_FEE_PERCENT="2.5"
AGGREGATOR_FEE_PERCENT="1.5"

# The university receives this share of the platform fee (20% of 2.5% = 0.5%).
UNIVERSITY_REVENUE_SHARE_PERCENT="20"

# Mock payment settlement delay in milliseconds (used by Snippe mock).
MOCK_SETTLEMENT_DELAY_MS="2000"

# SMS simulation. USSD/offline payments are paused in this build; the code is
# retained behind USSD_ENABLED=false.
SMS_PROVIDER="mock"
USSD_SHORTCODE="*150*88#"
USSD_ENABLED="false"

# Demo conveniences. Set DEMO_MODE=false for a production-like build:
# exposes OTP codes in API responses.
DEMO_MODE="true"

# Public app URL (used in SMS copy and metadata)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Google OAuth (students and vendors)
# Create an OAuth 2.0 Web Application client in Google Cloud Console.
# For local development, authorize:
#   http://localhost:3000/api/auth/callback/google
# For production, authorize https://<your-domain>/api/auth/callback/google and
# set GOOGLE_REDIRECT_URI to that exact URL in the hosting provider.
# Students must have a matching email in User.email. Seed accounts already have
# university emails; link a real Google email with:
#   pnpm link:google +255712345678 you@gmail.com
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"
GOOGLE_MOBILE_REDIRECT_URI=""



# Whop sandbox (https://sandbox.whop.com/dashboard/developer)
WHOP_API_KEY=
WHOP_ACCOUNT_ID=
WHOP_PRODUCT_ID=
WHOP_VARIANT_ID=
WHOP_CHECKOUT_ID=
WHOP_CHECKOUT_URL=
WHOP_WEBHOOK_SECRET=
WHOP_ENVIRONMENT=sandbox
# AzamPay sandbox (https://developers.azampay.co.tz)
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
# Optional if required by the AzamPay checkout application.
AZAMPAY_API_KEY=
AZAMPAY_APP_NAME=Kupon
AZAMPAY_ENVIRONMENT=sandbox
AZAMPAY_CALLBACK_TOKEN=
