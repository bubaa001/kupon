{
  "name": "kupon",
  "version": "1.0.0",
  "private": true,
  "description": "Kupon — digital campus wallet, QR cafeteria payments and profit intelligence for Tanzanian universities.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
